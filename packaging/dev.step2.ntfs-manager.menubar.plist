<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.step2.ntfs-manager.menubar</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Applications/NTFS Manager.app/Contents/MacOS/ntfs-manager-menubar</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>ThrottleInterval</key>
    <integer>5</integer>
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/NTFS Manager/menubar.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/NTFS Manager/menubar.log</string>
</dict>
</plist>
